{
	"name": "palettra",
	"version": "0.1.0",
	"description": "Tailwind color system generator for OKLCH palettes, typography, UI previews, WCAG contrast checks, and design-token exports.",
	"private": true,
	"keywords": [
		"tailwind-css",
		"color-palette",
		"color-system",
		"oklch",
		"design-tokens",
		"figma-tokens",
		"wcag",
		"typography",
		"nextjs"
	],
	"homepage": "https://palettra.design",
	"bugs": {
		"url": "https://github.com/weehong/palettra/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/weehong/palettra.git"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"typecheck": "tsc --noEmit",
		"format": "prettier \"{app,components,lib,e2e,__tests__}/**/*.{ts,tsx}\" --write",
		"test": "vitest run && playwright test",
		"test:unit": "vitest",
		"test:unit:run": "vitest run",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:report": "playwright show-report",
		"verify": "npm run lint && npm run typecheck && npm run test:unit:run && npm run test:e2e",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"commitlint": "commitlint --edit",
		"commitizen": "exec < /dev/tty && git cz --hook || true",
		"prepare": "husky",
		"setup": "npx husky init && npx playwright install"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"dependencies": {
		"@next/third-parties": "^16.2.10",
		"@tanstack/react-query": "^5.101.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"class-variance-authority": "^0.7.1",
		"client-only": "^0.0.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"culori": "^4.0.2",
		"firebase": "^12.15.0",
		"lucide-react": "^1.23.0",
		"next": "16.2.9",
		"nodemailer": "^9.0.5",
		"radix-ui": "^1.6.1",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-markdown": "^10.1.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@playwright/test": "^1.61.0",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/nextjs": "^10.4.6",
		"@tailwindcss/postcss": "^4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/culori": "^4.0.1",
		"@types/node": "^20",
		"@types/nodemailer": "^8.0.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.9",
		"commitizen": "^4.3.2",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^9",
		"eslint-config-next": "16.2.9",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.4.6",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.4",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"schema-dts": "^2.0.0",
		"storybook": "^10.4.6",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.9"
	}
}
