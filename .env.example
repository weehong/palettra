# Example environment variables for Palettra.
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
# `.env.local` is git-ignored; this template is safe to commit (no secrets).
# Restart the dev server after changing env files (Next.js reads env at startup).

# Enables the "AI theme" feature, which maps generated ramps onto the site chrome.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Default model for AI theme generation.
OPENROUTER_MODEL=openai/gpt-5-nano

# Optional. Absolute origin of the site (canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app public config.
# Find these in Firebase console > Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# GA4 measurement id from Google Analytics Admin > Data streams.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
