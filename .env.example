# Example environment variables for Palettra.
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
# `.env.local` is git-ignored; this template is safe to commit (no secrets).
# Restart the dev server after changing env files (Next.js reads env at startup).

# Enables the "AI theme" feature, which maps generated ramps onto the site chrome.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Default model for AI theme generation.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Optional. Absolute production origin for canonical URLs, sitemap, and OG tags.
# Local development already defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://palettra.design

# Firebase web app public config.
# Find these in Firebase console > Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# GA4 measurement id from Google Analytics Admin > Data streams.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Feedback channel. Submissions are emailed to the operator's mailbox; nothing
# is stored (see docs/adr/0001-feedback-is-email-only.md).
#
# The navbar "Feedback" button only renders when SMTP_HOST, SMTP_USER, and
# SMTP_PASSWORD are all set. Note that statically prerendered routes resolve
# that flag when the page is rendered, so a Docker deployment that supplies
# these only at `docker run` will not show the button on prebuilt pages —
# pass them at build time too.
#
# Gmail: create an app password at https://myaccount.google.com/apppasswords
# (host smtp.gmail.com, port 587). Microsoft/Outlook accounts are retiring
# basic-auth SMTP, so an Outlook user/password may be rejected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional. Where feedback is delivered. Defaults to SMTP_USER, so set this
# only when the mailbox you read differs from the account that sends.
FEEDBACK_TO_EMAIL=

# Optional. Display name on the From header. Defaults to "Palettra Feedback".
FEEDBACK_FROM_NAME=
