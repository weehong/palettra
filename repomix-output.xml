	});
});

function renderGenerator() {
	return render(<PaletteGenerator initialTheme={defaultTheme("#a543bc")} />);
}

function chooseFont(picker: HTMLElement, name: string): void {
	const dropdown = picker.closest("details");
	if (!dropdown) {
		throw new Error(`Font picker for ${name} is missing its dropdown wrapper.`);
	}
	fireEvent.click(picker);
	fireEvent.click(within(dropdown).getByRole("option", { name }));
}

