	status: "disabled",
	user: null as { uid: string } | null,
}));

const collectionState = vi.hoisted(() => ({
	savePalette: vi.fn(),
	listPalettes: vi.fn(),
}));

vi.mock("@/components/auth/auth-context", () => ({
	useAuth: () => authState,
}));
vi.mock("@/lib/firebase", () => ({
