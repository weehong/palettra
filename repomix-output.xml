	return {
		...actual,
		savePalette: (...args: Array<unknown>) => collectionState.savePalette(...args),
		listPalettes: (...args: Array<unknown>) => collectionState.listPalettes(...args),
	};
});

function renderWithQuery(children: ReactNode) {
	const queryClient = new QueryClient({
		defaultOptions: {
			queries: { retry: false },
			mutations: { retry: false },
		},
	});

	return render(
		<QueryClientProvider client={queryClient}>{children}</QueryClientProvider>,
	);
}

describe("palette collection UI", () => {
	beforeEach(() => {
		authState.status = "disabled";
		authState.user = null;
		collectionState.savePalette.mockReset();
		collectionState.listPalettes.mockReset();
	});

	it("hides the save button when Firebase auth is disabled", async () => {
		const { SavePaletteButton } = await import(
			"@/components/collection/save-palette-button"
		);

		renderWithQuery(
			<SavePaletteButton
				theme={defaultTheme("#a543bc")}
				typography={defaultTypography()}
			/>,
		);

		expect(screen.queryByRole("button", { name: "Save" })).not.toBeInTheDocument();
	});

	it("hides the save button for signed-out users", async () => {
		authState.status = "signed-out";
		const { SavePaletteButton } = await import(
			"@/components/collection/save-palette-button"
		);

		renderWithQuery(
			<SavePaletteButton
				theme={defaultTheme("#a543bc")}
				typography={defaultTypography()}
			/>,
