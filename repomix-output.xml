"use client";

import type { JSX } from "react";
import { useState } from "react";

import type { Typography } from "@/lib/typography";
import { generateTypeScale, SCALE_RATIOS } from "@/lib/typography";
import { fontStack } from "@/lib/fonts";
import { FontPicker } from "@/components/generator/font-picker";

type TypographyPanelProps = {
	typography: Typography;
	onChange: (next: Typography) => void;
	onRemove?: () => void;
};

const inputClass =
	"rounded-md border border-input bg-surface px-2 py-1 text-base text-foreground focus:border-ring focus:outline-none";

const WEIGHT_SPECIMEN: ReadonlyArray<{ label: string; weight: number }> = [
	{ label: "Black", weight: 900 },
	{ label: "Extra-Bold", weight: 800 },
	{ label: "Bold", weight: 700 },
	{ label: "Semi-Bold", weight: 600 },
	{ label: "Medium", weight: 500 },
	{ label: "Regular", weight: 400 },
	{ label: "Light", weight: 300 },
	{ label: "Extra-Light", weight: 200 },
	{ label: "Thin", weight: 100 },
];

/** Editor for the typography tokens: font families, base size, and scale ratio. */
export function TypographyPanel({
	typography,
	onChange,
	onRemove,
}: TypographyPanelProps): JSX.Element {
	const scale = generateTypeScale(typography.baseSize, typography.ratio);
	const [extraSampleFamilies, setExtraSampleFamilies] = useState<Array<string>>(
		[],
	);

	function setFamily(key: keyof Typography["fonts"], value: string): void {
		onChange({ ...typography, fonts: { ...typography.fonts, [key]: value } });
	}

	function addTypographySample(): void {
		setExtraSampleFamilies((prev) => [...prev, typography.fonts.heading]);
	}

	function setBaseSize(value: number): void {
		if (Number.isFinite(value) && value > 0) {
			onChange({ ...typography, baseSize: value });
		}
	}

	function setRatio(value: number): void {
		onChange({ ...typography, ratio: value });
	}

	function renderTypographySample(
		family: string,
		index: number,
		onFamilyChange: (family: string) => void,
	): JSX.Element {
		const sampleFamily = fontStack(family);
		return (
			<div
				data-testid="typography-sample"
				className="grid gap-5 rounded-lg border border-border bg-surface-muted p-4 md:grid-cols-[minmax(5rem,8rem)_minmax(0,1fr)]"
			>
				<div className="flex min-h-72 flex-col gap-3 overflow-hidden rounded-md bg-surface p-3">
					<FontPicker
						value={family}
						label={`Typography sample ${index}`}
						onChange={onFamilyChange}
						lazyOptions
					/>
					<p
						data-testid="typography-specimen-family"
						className="m-auto text-6xl leading-none font-black text-foreground"
						style={{
							fontFamily: sampleFamily,
							writingMode: "vertical-rl",
							transform: "rotate(180deg)",
						}}
					>
						{family}
					</p>
				</div>
				<div className="flex min-w-0 flex-col justify-center gap-2">
					{WEIGHT_SPECIMEN.map(({ label, weight }) => (
						<div key={label} className="flex min-w-0 flex-col">
							<p
								data-testid={
									label === "Black" ? "typography-sample-heading" : undefined
								}
								className="truncate text-foreground"
								style={{
									fontFamily: sampleFamily,
									fontSize: `${scale.xl}px`,
									fontStyle: "normal",
									fontWeight: weight,
								}}
							>
								{family} {label}
							</p>
							<p
								className="truncate text-foreground"
								style={{
									fontFamily: sampleFamily,
									fontSize: `${scale.xl}px`,
									fontStyle: "italic",
									fontWeight: weight,
								}}
							>
								{family} {label} Italic
							</p>
						</div>
					))}
				</div>
			</div>
		);
	}

	return (
		<section aria-label="Typography" className="flex min-h-full flex-col">
			<div className="flex flex-col gap-4 p-5 md:p-6">
				<div className="flex flex-col gap-4 rounded-xl border border-border p-5">
					<div className="flex flex-wrap items-center justify-between gap-3">
						<h2 className="text-base font-semibold text-foreground">
							Typography
						</h2>
						<div className="flex items-center gap-2">
							<div className="w-48">
								<FontPicker
									value={typography.fonts.heading}
									label="Heading"
									onChange={(name) => setFamily("heading", name)}
									lazyOptions
								/>
							</div>
							{onRemove ? (
								<button
									type="button"
									onClick={onRemove}
									aria-label="Remove typography"
									data-testid="remove-typography"
									className="rounded-md px-2 py-1 text-base text-muted hover:bg-surface-muted hover:text-destructive"
								>
									✕
								</button>
							) : null}
						</div>
					</div>

					{renderTypographySample(typography.fonts.heading, 1, (family) =>
						setFamily("heading", family),
					)}
					{extraSampleFamilies.map((family, index) => (
						<div key={index}>
							{renderTypographySample(family, index + 2, (nextFamily) => {
								setExtraSampleFamilies((prev) =>
									prev.map((current, sampleIndex) =>
										sampleIndex === index ? nextFamily : current,
									),
								);
							})}
						</div>
					))}
				</div>
			</div>

			<div
				data-testid="typography-sticky-footer"
				className="sticky bottom-0 z-10 mt-auto flex flex-wrap items-end justify-between gap-3 border-t border-border bg-surface px-5 py-3 md:px-6"
			>
				<div className="flex flex-wrap items-end gap-4">
					<label className="flex flex-col gap-1">
						<span className="text-sm font-medium text-muted">
							Root size (px)
						</span>
						<input
							type="number"
							min={1}
							value={typography.baseSize}
							onChange={(event) => setBaseSize(Number(event.target.value))}
							aria-label="Base font size in pixels"
							className={`w-24 ${inputClass}`}
						/>
					</label>

					<label className="flex flex-col gap-1">
						<span className="text-sm font-medium text-muted">
							Scale ratio
						</span>
						<select
							value={typography.ratio}
							onChange={(event) => setRatio(Number(event.target.value))}
							aria-label="Modular scale ratio"
							className={`w-44 ${inputClass}`}
						>
							{SCALE_RATIOS.map(({ name, value }) => (
								<option key={value} value={value}>
									{name} ({value})
								</option>
							))}
						</select>
					</label>
				</div>
				<button
					type="button"
					data-testid="add-typography"
					onClick={addTypographySample}
					className="inline-flex h-10 w-fit items-center rounded-md border border-input bg-surface px-3 text-base font-medium text-foreground transition-colors hover:bg-surface-muted"
				>
					Add Typography
				</button>
			</div>
		</section>
	);
}
