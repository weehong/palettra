import "client-only";

import { sendGAEvent } from "@next/third-parties/google";

type EventParams = Record<string, boolean | number | string | null | undefined>;

export type AnalyticsEvent =
	| "login"
	| "logout"
	| "login_error"
	| "sign_in_dialog_opened"
	| "palette_saved"
	| "palette_save_failed"
