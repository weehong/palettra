vi.mock("@/lib/analytics", () => ({
	trackEvent: vi.fn(),
}));
vi.mock("next/navigation", () => ({
	useRouter: () => ({ push: vi.fn() }),
}));
vi.mock("@/lib/palette-collection", async (importOriginal) => {
