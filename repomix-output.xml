   132	}
   133	
   134	export function createCustomRole(hex: string, index: number): ColorRole {
   135		return {
   136			id: nextRoleId("custom"),
   137			name: `Color ${index}`,
   138			hex,
   139			auto: false,
   140		};
   141	}
   142	
   143	export function defaultTheme(primaryHex: string = DEFAULT_HEX): Theme {
   144		return { roles: [createPrimaryRole(primaryHex)] };
   145	}
   146	
   147	/**
   148	 * Serialize the non-primary roles into a compact `colors` query value, e.g.
   149	 * `secondary~1e88e5~a,brand~ff8800`. Slugs and hex never contain the `~`/`,`
   150	 * separators, so this stays human-readable and reversible.
   151	 */
   152	export function encodeRoles(theme: Theme): string {
   153		return theme.roles
   154			.slice(1)
   155			.map((role) => {
   156				const slug = slugify(role.name);
   157				const hex = role.hex.replace(/^#/, "");
   158				return role.auto ? `${slug}~${hex}~a` : `${slug}~${hex}`;
   159			})
   160			.join(",");
   161	}
   162	
   163	/** Parse the `colors` query value back into roles, skipping malformed entries. */
   164	export function decodeRoles(
   165		value: string | null | undefined,
   166	): Array<ColorRole> {
   167		if (!value) {
   168			return [];
   169		}
   170		const roles: Array<ColorRole> = [];
   171		value.split(",").forEach((entry, index) => {
   172			const [slug, hex, flag] = entry.split("~");
   173			const normalized = normalizeHex(hex ?? "");
   174			if (!slug || !normalized) {
   175				return;
   176			}
   177			const auto = flag === "a";
   178			const preset = PRESET_ORDER.find((p) => p === slug);
   179			roles.push({
   180				id: `${slug}-${index}`,
   181				name: titleFromSlug(slug),
   182				hex: normalized,
   183				auto: auto && Boolean(preset),
   184				preset,
   185			});
   186		});
   187		return roles;
   188	}
   189	
   190	/**
   191	 * Build a `/generate/<primary>` href carrying the extra roles in `?colors`, the
   192	 * non-default typography in `?type`, and the selected preview template in
   193	 * `?preview`. The caller passes `previewKey` only when it is not the default.
   194	 */
   195	export function buildThemeHref(
   196		theme: Theme,
   197		typography?: Typography,
   198		previewKey?: string,
   199	): string {
   200		const primary = theme.roles[0]?.hex ?? DEFAULT_HEX;
   201		const parts: Array<string> = [];
   202		const encoded = encodeRoles(theme);
   203		if (encoded.length > 0) {
   204			parts.push(`colors=${encoded}`);
   205		}
   206		if (typography && !isDefaultTypography(typography)) {
   207			parts.push(`type=${encodeTypography(typography)}`);
   208		}
   209		if (previewKey) {
   210			parts.push(`preview=${previewKey}`);
   211		}
   212		const query = parts.length > 0 ? `?${parts.join("&")}` : "";
   213		return `/generate/${primary.replace(/^#/, "")}${query}`;
   214	}

