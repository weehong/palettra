					onClick={() => {
						onImportStitch();
						close();
					}}
					className={itemClass}
				>
					<span className="text-base font-medium text-foreground">
						Import from Google Stitch
					</span>
					<span className="text-sm text-muted">
						Paste a Stitch design spec.
					</span>
				</button>

				<div className="my-1.5 border-t border-border" />

