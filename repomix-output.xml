<file path="components/generator/import-palette-dialog.tsx">
"use client";

import type { ChangeEvent, JSX, MouseEvent } from "react";
import { useEffect, useMemo, useRef, useState } from "react";

import type { ImportedColor } from "@/lib/import-palette";
import { parsePaletteInput } from "@/lib/import-palette";

type ImportPaletteDialogProps = {
	open: boolean;
	onOpenChange: (open: boolean) => void;
	onImport: (colors: ReadonlyArray<ImportedColor>) => void;
	requiresConfirmation?: boolean;
};

/**
 * Paste a coolors.co URL, a hex list, or a uicolors.app JSON export (or load
 * the .json file directly) and append the parsed colors as roles. JSON groups
 * keep their palette names. Colors are extracted live for a preview; importing
 * is disabled until at least one valid color is found.
 */
export function ImportPaletteDialog({
	open,
	onOpenChange,
	onImport,
	requiresConfirmation = false,
}: ImportPaletteDialogProps): JSX.Element {
	const ref = useRef<HTMLDialogElement>(null);
	const [value, setValue] = useState<string>("");
	const [isConfirmingImport, setIsConfirmingImport] = useState<boolean>(false);

	useEffect(() => {
		const el = ref.current;
		if (!el) {
			return;
		}
		// jsdom does not implement showModal/close; guard so tests don't throw.
		if (open && !el.open && typeof el.showModal === "function") {
			el.showModal();
		}
		if (!open && el.open && typeof el.close === "function") {
			el.close();
		}
	}, [open]);

	const colors = useMemo(() => parsePaletteInput(value), [value]);

	function closeDialog(): void {
		setIsConfirmingImport(false);
		onOpenChange(false);
	}

	function handleImport(): void {
		if (colors.length === 0) {
			return;
		}
		if (requiresConfirmation && !isConfirmingImport) {
			setIsConfirmingImport(true);
			return;
		}
		onImport(colors);
		closeDialog();
		setValue("");
	}

	function handleFileChange(event: ChangeEvent<HTMLInputElement>): void {
		const file = event.target.files?.[0];
		if (!file) {
			return;
		}
		void file.text().then((text) => {
			setValue(text);
			setIsConfirmingImport(false);
		});
		// Reset so re-selecting the same file fires another change event.
		event.target.value = "";
	}

	function handleBackdropClick(event: MouseEvent<HTMLDialogElement>): void {
		if (event.target === ref.current) {
			closeDialog();
		}
	}

	return (
		<dialog
			ref={ref}
			onClose={closeDialog}
			onClick={handleBackdropClick}
			className="m-auto w-full max-w-md rounded-xl p-0 backdrop:bg-overlay/50"
		>
			<div className="flex flex-col gap-4 bg-surface-elevated p-6 text-foreground">
				<div className="flex items-center justify-between">
					<h2 className="text-lg font-semibold">Import palette</h2>
					<button
						type="button"
						onClick={closeDialog}
						aria-label="Close"
						className="rounded-md px-2 py-1 text-muted hover:bg-surface-muted"
					>
						✕
					</button>
				</div>

				{isConfirmingImport ? (
					<div
						role="alert"
						className="rounded-lg border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive"
					>
						<p className="font-medium">
							Save your current palette before importing.
						</p>
						<p className="mt-1">
							Importing will overwrite your existing colors. Export or keep the
							current share URL if you need the existing colors later.
						</p>
					</div>
				) : null}

				<label className="flex flex-col gap-1 text-sm">
					<span className="font-medium text-muted">
						Coolors URL, hex list, or uicolors.app JSON
					</span>
					<textarea
						value={value}
						onChange={(event) => {
							setValue(event.target.value);
							setIsConfirmingImport(false);
						}}
						rows={3}
						spellCheck={false}
						placeholder="https://coolors.co/264653-2a9d8f-e9c46a or a uicolors.app JSON export"
						aria-label="Coolors URL, hex list, or uicolors.app JSON"
						className="resize-none rounded-md border border-input bg-surface px-3 py-2 font-mono text-sm focus:border-ring focus:outline-none"
					/>
				</label>

				<label className="flex items-center gap-2 text-sm">
					<span className="cursor-pointer rounded-md border border-input px-3 py-1.5 font-medium text-muted hover:bg-surface-muted">
						Load JSON file…
					</span>
					<input
						type="file"
						accept=".json,application/json"
						onChange={handleFileChange}
						aria-label="Load JSON file"
						className="sr-only"
					/>
				</label>

				<div className="flex min-h-[2rem] flex-wrap items-center gap-2">
					{colors.length > 0 ? (
						colors.map((color) => (
							<span
								key={`${color.name ?? ""}-${color.hex}`}
								className="flex items-center gap-1.5 rounded-md border border-border py-0.5 pr-2 pl-0.5 text-xs"
							>
								<span
									className="h-5 w-5 rounded"
									style={{ backgroundColor: color.hex }}
									aria-hidden="true"
								/>
								{color.name ? <span>{color.name}</span> : null}
								<span className="font-mono">{color.hex}</span>
							</span>
						))
					) : (
						<span className="text-xs text-muted">
							{value.trim().length > 0
								? "No valid colors found."
								: "Paste a palette to preview the colors."}
						</span>
					)}
				</div>

				<div className="flex justify-end gap-2">
					{isConfirmingImport ? (
						<button
							type="button"
							onClick={() => setIsConfirmingImport(false)}
							className="rounded-md border border-input bg-surface px-4 py-2 text-base font-medium text-foreground hover:bg-surface-muted"
						>
							Review import
						</button>
					) : null}
					<button
						type="button"
						onClick={handleImport}
						disabled={colors.length === 0}
						className="rounded-md bg-primary px-4 py-2 text-base font-medium text-primary-foreground hover:bg-primary-hover disabled:opacity-50"
					>
						{isConfirmingImport
							? "Import colors"
							: colors.length > 0
								? `Import ${colors.length} color${colors.length === 1 ? "" : "s"}`
								: "Import"}
					</button>
				</div>
			</div>
		</dialog>
	);
}
</file>

<file path="components/generator/import-stitch-dialog.tsx">
"use client";

import type { JSX, MouseEvent } from "react";
import { useEffect, useMemo, useRef, useState } from "react";

import type { StitchSpec } from "@/lib/stitch";
import { parseStitchSpec } from "@/lib/stitch";

type ImportStitchDialogProps = {
	open: boolean;
	onOpenChange: (open: boolean) => void;
	onImportStitch: (spec: StitchSpec) => void;
};

type ParseResult = { spec: StitchSpec | null; error: string | null };

/** Parse without throwing; an empty or malformed paste yields a null spec. */
function safeParse(value: string): ParseResult {
	if (value.trim().length === 0) {
		return { spec: null, error: null };
	}
	try {
		const spec = parseStitchSpec(value);
		const tokenCount =
			Object.keys(spec.colors).length + Object.keys(spec.typography).length;
		if (tokenCount === 0) {
			return {
				spec: null,
				error: "No color or typography tokens found in the frontmatter.",
			};
		}
		return { spec, error: null };
	} catch {
		return { spec: null, error: "Could not parse the YAML frontmatter." };
	}
}

const KEY_TOKENS = [
	"primary",
	"secondary",
	"tertiary",
	"error",
	"surface",
	"on-surface",
	"surface-container-high",
	"outline",
] as const;

/**
 * Paste a Google Stitch design spec (Markdown with YAML frontmatter) and import
 * it natively. The spec is parsed live for a validation summary; importing is
 * disabled until a spec with at least one token is found.
 */
export function ImportStitchDialog({
	open,
	onOpenChange,
	onImportStitch,
}: ImportStitchDialogProps): JSX.Element {
	const ref = useRef<HTMLDialogElement>(null);
	const [value, setValue] = useState<string>("");

	useEffect(() => {
		const el = ref.current;
		if (!el) {
			return;
		}
		// jsdom does not implement showModal/close; guard so tests don't throw.
		if (open && !el.open && typeof el.showModal === "function") {
			el.showModal();
		}
		if (!open && el.open && typeof el.close === "function") {
			el.close();
		}
	}, [open]);

	const { spec, error } = useMemo(() => safeParse(value), [value]);

	function handleImport(): void {
		if (!spec) {
			return;
		}
		onImportStitch(spec);
		onOpenChange(false);
		setValue("");
	}

	function handleBackdropClick(event: MouseEvent<HTMLDialogElement>): void {
		if (event.target === ref.current) {
			onOpenChange(false);
		}
	}

	const colorCount = spec ? Object.keys(spec.colors).length : 0;
	const styleCount = spec ? Object.keys(spec.typography).length : 0;
	const swatches = spec
		? KEY_TOKENS.filter((token) => spec.colors[token]).map((token) => ({
				token,
				hex: spec.colors[token],
			}))
		: [];

	return (
		<dialog
			ref={ref}
			onClose={() => onOpenChange(false)}
			onClick={handleBackdropClick}
			className="m-auto w-full max-w-lg rounded-xl p-0 backdrop:bg-overlay/50"
		>
			<div className="flex flex-col gap-4 bg-surface-elevated p-6 text-foreground">
				<div className="flex items-center justify-between">
					<h2 className="text-lg font-semibold">Import Stitch spec</h2>
					<button
						type="button"
						onClick={() => onOpenChange(false)}
						aria-label="Close"
						className="rounded-md px-2 py-1 text-muted hover:bg-surface-muted"
					>
						✕
					</button>
				</div>

				<label className="flex flex-col gap-1 text-sm">
					<span className="font-medium text-muted">
						Paste the Google Stitch Markdown (frontmatter + prose)
					</span>
					<textarea
						value={value}
						onChange={(event) => setValue(event.target.value)}
						rows={6}
						spellCheck={false}
						placeholder={"---\ncolors:\n  primary: '#9f0026'\n  …\n---"}
						aria-label="Stitch spec markdown"
						className="resize-none rounded-md border border-input bg-surface px-3 py-2 font-mono text-sm focus:border-ring focus:outline-none"
					/>
				</label>

				<div className="flex min-h-[3rem] flex-col gap-2">
					{spec ? (
						<>
							<p className="text-sm text-muted">
								{colorCount} color tokens · {styleCount} type styles ·{" "}
								{Object.keys(spec.rounded).length} radius ·{" "}
								{Object.keys(spec.spacing).length} spacing ·{" "}
								{spec.sections.length} prose sections
							</p>
							<div className="flex flex-wrap gap-2">
								{swatches.map(({ token, hex }) => (
									<span
										key={token}
										className="flex items-center gap-1.5 rounded-md border border-border py-0.5 pl-0.5 pr-2 text-xs"
										title={token}
									>
										<span
											className="h-5 w-5 rounded"
											style={{ backgroundColor: hex }}
											aria-hidden="true"
										/>
										<span className="font-mono">{token}</span>
									</span>
								))}
							</div>
						</>
					) : (
						<span className="text-xs text-muted">
							{error ??
								"Paste a Stitch design spec to preview its Material tokens."}
						</span>
					)}
				</div>

				<p className="text-sm text-muted">
					Colors are saved to the URL; re-import the spec to restore the full
					Material token set, type styles, and brand notes.
				</p>

				<div className="flex justify-end">
					<button
						type="button"
						onClick={handleImport}
						disabled={!spec}
						className="rounded-md bg-primary px-4 py-2 text-base font-medium text-primary-foreground hover:bg-primary-hover disabled:opacity-50"
					>
						{spec ? "Import spec" : "Import"}
					</button>
				</div>
			</div>
		</dialog>
	);
}
</file>

