		return { h: 0, s: 0, l: 0 };
	}
	return {
		h: c.h ?? 0,
		s: (c.s ?? 0) * 100,
		l: (c.l ?? 0) * 100,
	};
}

/** Convert degrees/percentage HSL back to a canonical lowercase hex. */
export function hslToHex(color: Hsl): string {
	return formatHex({
		mode: "hsl",
		h: color.h,
		s: color.s / 100,
		l: color.l / 100,
