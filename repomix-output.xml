<file path="__tests__/page.test.tsx">
import { describe, expect, it } from "vitest";
import { render, screen } from "@testing-library/react";

import Home from "@/app/page";
import GeneratePage from "@/app/generate/[hex]/page";
import { siteConfig } from "@/lib/site-config";

describe("Home page", () => {
	it("renders the generator heading", () => {
		render(<Home />);
		expect(
			screen.getByRole("heading", {
				level: 1,
				name: siteConfig.headline,
			}),
		).toBeInTheDocument();
	});

	it("adds vertical padding to the caption text", async () => {
		render(<Home />);
		expect(screen.getByText(siteConfig.caption)).toHaveClass("py-1");

		const page = await GeneratePage({
			params: Promise.resolve({ hex: "a543bc" }),
			searchParams: Promise.resolve({}),
		});
		render(page);
		expect(screen.getAllByText(siteConfig.caption)[1]).toHaveClass("py-1");
	});

	it("renders the full 50–950 scale", () => {
		render(<Home />);
		expect(screen.getAllByTestId("swatch")).toHaveLength(11);
	});

	it("keeps the app shell to one viewport without parent scrolling", () => {
		const { container } = render(<Home />);
		expect(container.querySelector("main")).toHaveClass(
			"flex-1",
			"min-h-0",
			"overflow-hidden",
		);
	});

	it("uses the same viewport shell on generated color routes", async () => {
		const page = await GeneratePage({
			params: Promise.resolve({ hex: "a543bc" }),
			searchParams: Promise.resolve({}),
		});
		const { container } = render(page);
		expect(container.querySelector("main")).toHaveClass(
			"flex-1",
			"min-h-0",
			"overflow-hidden",
		);
	});
});
